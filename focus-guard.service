[Unit]
Description=Lock the PC after a missed focus-project day until today's minutes are in
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/python3 -m focus_guard lock --production
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=0

[Install]
WantedBy=graphical-session.target
